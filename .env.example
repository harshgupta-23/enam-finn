# ==============================================================================
# FINN - AI Model Settings
# ==============================================================================

# 1. Google Gemini API Key (Get a free key from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Which model runs each task:

# Used when you search a stock: pulls its 3 main profit drivers and supply chain (e.g. L&T -> Steel)
MODEL_PULL_RESEARCH=gemini-3.5-flash-lite

# Used in "Promise vs Reality": checks if management delivered what they promised in earnings calls
MODEL_NARRATIVE_AUDIT=gemini-3.5-flash-lite

# Used in Push feed: separates big news (Results, M&A) from boring routine paperwork (ESOPs)
MODEL_FILINGS_TRIAGE=gemini-3.5-flash-lite

# Used when a CEO/CFO changes: writes a quick 2-line bio of who the new person is and their background
MODEL_EXEC_ENRICHMENT=gemini-3.5-flash-lite

# Backup model used automatically if your main model is ever busy or unavailable
MODEL_FALLBACK=gemini-2.5-flash-lite

# 3. Server Port
PORT=3001
